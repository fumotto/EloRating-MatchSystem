# 環境変数テンプレート（11_Deployment.md 4章）
#
# 本ファイルへ実際の値を記載してはならない。
# 値を設定したファイルは .env とし、Git へコミットしない（11_Deployment.md 14章）。

# ---------------------------------------------------------------------------
# フロントエンド（ビルド成果物に埋め込まれ、公開される）
#
# ★VITE_ 接頭辞の変数へ秘密情報を設定してはならない。
# ---------------------------------------------------------------------------

# Supabase の URL。ローカルは supabase start の出力（API URL）を使う。
VITE_SUPABASE_URL=

# Anon Key。公開される前提の鍵である。Service Role Key を設定してはならない。
VITE_SUPABASE_ANON_KEY=

# 配信ベースパス。ローカルは "/"、GitHub Pages のサブパス配信では "/<repo>/" を指定する。
VITE_BASE_PATH=/

# ---------------------------------------------------------------------------
# 認証プロバイダ（Supabase Local 用 / ADR-022）
#
# Discord Developer Portal で取得する。
# 本番・Staging では Supabase ダッシュボード側に設定するため、本ファイルは使用しない。
# ---------------------------------------------------------------------------

SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=

# ---------------------------------------------------------------------------
# バックエンド（Edge Functions）
#
# ★以下はバックエンドのみで利用する。フロントエンドへ渡してはならない。
#   クラウド環境では supabase secrets set で設定する。
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Connection Pooler（Supavisor）経由のDB接続文字列（ADR-016）。
# Transaction mode を使用し、prepared statement を無効化すること（11_Deployment.md 5.1）。
SUPABASE_DB_URL=
