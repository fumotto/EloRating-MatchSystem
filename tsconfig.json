{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Unit テストは Deno 側と共有するモジュールを `.ts` 付きで import する。
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "node"]
  },
  // Node側（Vite / Vitest）が扱う範囲のみ。supabase/ と tests/integration/ は Deno コードであり、
  // Denoグローバルと https: の import を含むため tsc では解決できない。
  // Deno側の型検査は `deno check` が担う（package.json の typecheck を参照）。
  "include": ["src", "tests/unit", "vite.config.ts", "vitest.config.ts"]
}
